# Copie para .env e ajuste. Depois de mudar, reinicie o `npx expo start`.

# true (padrão) = dados simulados de src/services/mock/ · false = APIs reais
EXPO_PUBLIC_USE_MOCK=true

# No celular físico, troque localhost pelo IP do computador na rede (ex.: http://192.168.0.10:5080/api)
EXPO_PUBLIC_API_CIDADAO=http://localhost:5080/api
EXPO_PUBLIC_API_TELEMETRIA=http://localhost:8081/api

# Normaliza quebras de linha no repositório
* text=auto

# Arquivos que rodam no Linux/containers precisam de LF (CRLF quebra o bash)
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf
*.sql text eol=lf
.env* text eol=lf
mvnw text eol=lf

# Scripts do Windows
*.cmd text eol=crlf
*.bat text eol=crlf
